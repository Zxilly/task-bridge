# Copy to deploy/.env and restrict access to the file.
BRIDGE_DOMAIN=bridge.example.com
ACME_EMAIL=admin@example.com
# Generate independently from all A/B device tokens. Empty fails Compose validation.
BRIDGE_ADMIN_TOKEN=
# Local image built by docker compose; no registry publication is required.
BRIDGE_IMAGE=task-bridge:0.1.0-local
GO_VERSION=1.26.0
CADDY_IMAGE=caddy:2.11.7-alpine
